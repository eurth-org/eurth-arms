---
// The maker, and under it what search engines and newcomers both want: what it is, how to use
// it, and answers to the usual questions (also given to search engines as structured data).
import { faqPage, webApplication } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { footerCredit } from '../arms/credits';
import { templates } from '../arms/templates';
import { figureAlt, figureSrc, HEIGHT, WIDTH } from '../lib/figures';

const faq = [
  { q: 'Is Arms free?', a: 'Yes. There is no account, no watermark and no paid tier. It is made by the Eurth worldbuilding community for anyone who needs a coat of arms for a country, a house or a city that doesn’t exist.' },
  { q: 'What is a blazon?', a: 'The description of a coat of arms in the language of heraldry, such as “Azure, a chevron Or between three mullets argent”. Arms writes the blazon as you build, and draws the arms when you type one.' },
  { q: 'What is the rule of tincture?', a: 'Never put a colour on a colour or a metal on a metal. It keeps arms readable at a distance. Arms checks every layer as you work, tells you in words what is wrong, and can fix it in one click.' },
  { q: 'Where are my arms saved?', a: 'In their link. The link holds the whole design, so copying the link is saving it. You can also download the picture, or save your nation as a profile file that the other Eurth tools can read. Nothing is kept in your browser or on a server.' },
  { q: 'May I use the arms I make?', a: 'Yes, for anything. The blazon is yours. One thing to know: the lions were drawn by Sodacan and are shared under CC BY-SA 3.0, so a picture with a lion in it should credit Sodacan and be shared on the same terms. Arms writes that credit into the pictures it saves.' },
  { q: 'Does it work offline, and on a phone?', a: 'Yes to both. After the first visit the site keeps a copy of itself on your device and opens without a connection.' },
];
const shown = templates.slice(0, 6);
---

<Page site={site} jsonld={[webApplication(site, { featureList: ['Six shield shapes', 'Divisions, ordinaries and lines of partition', 'Lions and eagles in fourteen attitudes', 'Rule of tincture check with one-click fixes', 'Blazon written and read', 'SVG, PNG and WebP downloads', 'Nation profile file'] }), faqPage(faq)]}>
  <div class="eu-stack">
    <header class="eu-stack intro">
      <p class="eu-kicker">Coat-of-arms maker</p>
      <h1>Design arms that follow the rules</h1>
      <p class="eu-lead">Pick a shield, a field, an ordinary and a charge. Arms writes the blazon, checks the rule of tincture and draws the result. Free, in your browser, no account needed.</p>
    </header>

    <section class="eu-prose">
      <h2>How it works</h2>
      <ol>
        <li>Choose a shield, then a field: one tincture, a division or a pattern.</li>
        <li>Add an ordinary and a charge, and give each its tincture. Every swatch carries its name.</li>
        <li>Watch the rule of tincture: if a colour lands on a colour, Arms says where, and offers a fix.</li>
        <li>Copy the blazon, the link or the picture, or type a blazon of your own and see it drawn.</li>
      </ol>
      <p>New to heraldry? The <a href="/guide/">guide</a> explains it in eight short parts, the <a href="/glossary/">glossary</a> has the words, and the <a href="/templates/">templates</a> give you somewhere to start.</p>

      <h2>Somewhere to start</h2>
    </section>
    <ul class="starts">
      {
        shown.map((t) => (
          <li>
            <a href={`/templates/#${t.id}`}>
              <img src={figureSrc(t.blazon, t.shape)} alt={figureAlt(t.blazon, t.shape)} width={WIDTH} height={HEIGHT} loading="lazy" decoding="async" />
              <span>{t.nation}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <section class="eu-prose">
      <h2>Questions</h2>
      <dl>
        {
          faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>

  <Fragment slot="inspirations">Arms is Flagwright's sister tool. {footerCredit}</Fragment>
</Page>

<style>
  .intro {
    gap: var(--space-2);
  }

  .starts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: var(--space-4);
    max-width: var(--size-measure);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .starts a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    font: var(--type-body-sm);
  }

  .starts img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
