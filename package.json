{
  "name": "eurth-arms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Arms: a free online coat-of-arms maker that follows the rules of heraldry, by Eurth. Static Astro site with a Svelte tool, on Cloudflare Workers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "axe": "eurth-axe dist",
    "smoke": "eurth-smoke",
    "images": "node tools/make-images.mjs",
    "sheet": "vitest run --config vitest.sheet.config.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.6",
    "@eurth/profile": "github:eurth-org/eurth-profile#semver:^1",
    "@eurth/style": "github:eurth-org/eurth-style#semver:^1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "astro": "^7.4.12",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
